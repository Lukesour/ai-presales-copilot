{
  "parameters": [
    {
      "$ref": "../components/http-boundary.json#/parameters/RunId"
    },
    {
      "$ref": "../components/http-boundary.json#/parameters/ProjectHeader"
    }
  ],
  "post": {
    "operationId": "recordRunFeedback",
    "summary": "Record reviewer or presales feedback with optimistic concurrency.",
    "parameters": [
      {
        "$ref": "../components/http-boundary.json#/parameters/IdempotencyKey"
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "../components/reviews.json#/schemas/FeedbackRequest"
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Updated run state.",
