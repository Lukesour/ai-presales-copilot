{
  "schemas": {
    "ChatMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["system", "user", "assistant"]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "ChatCompletionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "../components/chat.json#/schemas/ChatMessage"
          }
        }
      }
    },
    "ChatCompletionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object", "created", "model", "run_id", "choices", "usage"],
      "properties": {
        "id": {
          "type": "string"
        },
        "object": {
          "const": "chat.completion"
        },
        "created": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "message", "finish_reason"],
            "properties": {
              "index": {
                "type": "integer"
              },
              "message": {
                "type": "object",
                "required": ["role", "content"],
                "properties": {
                  "role": {
                    "const": "assistant"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              },
              "finish_reason": {
                "const": "stop"
              }
            }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "prompt_tokens": {
              "type": ["integer", "null"]
            },
            "completion_tokens": {
              "type": ["integer", "null"]
            },
            "total_tokens": {
              "type": ["integer", "null"]
            }
          }
        }
      }
    }
  }
}
