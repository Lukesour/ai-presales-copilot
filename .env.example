# Dify app API (keep secrets out of Git)
DIFY_BASE_URL=http://127.0.0.1:8081
DIFY_APP_API_KEY=
DIFY_USER=portfolio-demo
DIFY_TIMEOUT_S=60

# llama.cpp OpenAI-compatible server
LLAMA_BASE_URL=http://127.0.0.1:8080
# Must match llama-server --alias / the id returned by /v1/models.
LLAMA_MODEL=qwen3-8b-q4
LLAMA_SERVER_BIN=llama-server
LLAMA_MODEL_PATH=
LLAMA_TIMEOUT_S=120
LLAMA_CONTEXT=8192
LLAMA_GPU_LAYERS=999
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:17155a3ce4cc906728ec99a2814bf0b4eaffaf3b4872bad8c3affed310cdbc35
LLAMA_MODEL_FILE=Qwen3-8B-Q4_K_M.gguf
MODEL_DIR=../models
LLAMA_MODEL_SHA256=

# Phase 1 API development auth. Replace with OIDC/JWT before shared deployment.
PRESALES_ALLOW_DEV_AUTH=true
PRESALES_DEV_TOKEN=dev-token

# Optional model provider metadata for reports
REMOTE_MODEL_NAME=trial-api-model
REMOTE_INPUT_COST_PER_MILLION=0
REMOTE_OUTPUT_COST_PER_MILLION=0
