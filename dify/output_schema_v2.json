              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "claim_id",
        "text",
        "claim_type",
        "support_status"
      ],
      "title": "ClaimV2",
      "type": "object"
